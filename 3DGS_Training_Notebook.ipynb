    "\n",
    "# 2. Cài đặt các thư viện Python bổ trợ\n",
    "!pip install plyfile tqdm opencv-python\n",
    "\n",
    "# 3. Clone Repository 3DGS gốc của INRIA\n",
    "%cd /content\n",
