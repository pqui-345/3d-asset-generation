  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Bước 6: Đóng gói kết quả & Tải về máy\n",
    "\n",
    "Sau khi huấn luyện xong, tệp kết quả `.ply` sẽ nằm tại thư mục `output/<hash>/point_cloud/iteration_7000/point_cloud.ply`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import glob\n",
    "import shutil\n",
    "\n",
    "# Tìm thư mục output\n",
    "output_dirs = glob.glob('/content/gaussian-splatting/output/*')\n",
    "if not output_dirs:\n",
    "    print(\"❌ LỖI: Không tìm thấy kết quả huấn luyện. Vui lòng kiểm tra lại Bước 5!\")\n",
    "else:\n",
    "    latest_output = output_dirs[0]\n",
    "    ply_file = os.path.join(latest_output, 'point_cloud', 'iteration_7000', 'point_cloud.ply')\n",
    "    \n",
    "    if os.path.exists(ply_file):\n",
    "        # Copy tệp kết quả trực tiếp ra Google Drive của bạn\n",
    "        drive_dest = '/content/drive/MyDrive/point_cloud_3dgs.ply'\n",
