    "%cd gaussian-splatting"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Bước 3: Tải Video lên và Tự động trích xuất ảnh (Video Frame Extraction)\n",
    "\n",
    "*Nhấp vào biểu tượng thư mục ở thanh bên trái của Colab, kéo thả tệp video `input_video.mp4` của bạn vào đó.*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import os\n",
    "\n",
    "video_path = '/content/input_video.mp4'  # Đường dẫn tới video bạn vừa upload\n",
    "output_dir = '/content/dataset_input'    # Thư mục chứa ảnh đầu ra\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "if not os.path.exists(video_path):\n",
    "    print(\"❌ LỖI: Vui lòng upload file 'input_video.mp4' vào mục files trước khi chạy ô này!\")\n",
    "else:\n",
    "    vidcap = cv2.VideoCapture(video_path)\n",
    "    success, image = vidcap.read()\n",
    "    count = 0\n",
    "    frame_interval = 12  # Cứ 12 khung hình thì trích xuất 1 ảnh (khoảng 3 ảnh/giây với video 30fps)\n",
    "    saved_count = 0\n",
    "\n",
    "    while success:\n",
    "        if count % frame_interval == 0:\n",
    "            cv2.imwrite(os.path.join(output_dir, f\"frame_{saved_count:04d}.png\"), image)\n",
    "            saved_count += 1\n",
    "        success, image = vidcap.read()\n",
    "        count += 1\n",
    "    print(f"✅ Đã trích xuất thành công {saved_count} ảnh từ video và lưu vào {output_dir}")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
